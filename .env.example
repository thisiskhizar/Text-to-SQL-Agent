# OpenAI credentials
OPENAI_API_KEY=sk-...

# LangSmith tracing (optional but recommended)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
